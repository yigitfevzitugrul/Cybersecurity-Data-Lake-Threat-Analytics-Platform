# Bu dosyayı .env olarak kopyala ve değerleri değiştir. .env git'e girmez.
# Parolalarda sadece harf ve rakam kullan (bağlantı adreslerinin içine yazılıyorlar).

# --- PostgreSQL (uygulama verisi + Airflow metadata) ---
POSTGRES_USER=secdl
POSTGRES_PASSWORD=change_me
POSTGRES_DB=security_lake
POSTGRES_HOST=localhost
# Host tarafındaki port. 5432 yerel bir PostgreSQL kurulumuyla çakışabildiği için 5433.
POSTGRES_PORT=5433

# --- Airflow (http://localhost:8080, kullanıcı: admin) ---
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_PASSWORD=change_me
AIRFLOW_SECRET_KEY=change_me_to_a_long_random_string

# --- Grafana (http://localhost:3000, kullanıcı: admin) ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=change_me
# Grafana'nın veritabanına bağlandığı salt-okunur rol
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=change_me

# --- AWS Data Lake (Seviye 5) ---
# Kimlik bilgileri burada tutulmaz: `aws configure` ile kurulan varsayılan profil kullanılır.
AWS_REGION=eu-central-1
# Bucket adı dünya genelinde benzersiz olmalı; hesap numarasını eklemek bunu kolaylaştırır.
S3_BUCKET=secdl-datalake-<hesap-no>-eu-central-1
GLUE_DATABASE=security_lake
ATHENA_WORKGROUP=secdl
AWS_PIPELINE_ROLE_NAME=secdl-pipeline
# `python -m src.cloud.setup` çıktısındaki değeri buraya yaz.
AWS_PIPELINE_ROLE_ARN=
# Aylık bütçe uyarısı (boş bırakılırsa bütçe oluşturulmaz)
BUDGET_ALERT_EMAIL=
BUDGET_LIMIT_USD=5
