    {
      "id": 7,
      "type": "timeseries",
      "title": "Günlük alarmlar (kurala göre)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(window_start, '1d'), rule AS metric, COUNT(*) AS value\nFROM alerts\nWHERE $__timeFilter(window_start)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "barWidthFactor": 0.6,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*brute_force.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*password_spray.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*suspicious_ip.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*auth_anomaly.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*privilege_abuse.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*sensitive_command.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*escalation_chain.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-purple"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Önem derecesine göre alarmlar",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT severity, COUNT(*) AS adet\nFROM alerts\nWHERE $__timeFilter(window_start)\nGROUP BY severity\nORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "severity",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "colorByField": "severity"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "low": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Son alarmlar",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT window_start AS \"Başlangıç\", rule AS \"Kural\", severity AS \"Önem\",\n       host(source_ip) AS \"Kaynak IP\", COALESCE(username, '(birden çok)') AS \"Kullanıcı\",\n       attempt_count AS \"Başarısız deneme\", distinct_users AS \"Farklı kullanıcı\",\n       ROUND(EXTRACT(EPOCH FROM window_end - window_start) / 60) AS \"Süre (dk)\",\n       COALESCE((SELECT string_agg(r, ', ') FROM jsonb_array_elements_text(details->'reasons') r), '') AS \"Sebep\",\n       array_to_string(mitre_techniques, ', ') AS \"ATT&CK\"\nFROM alerts\nWHERE $__timeFilter(window_start)\nORDER BY window_start DESC\nLIMIT 100"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Önem"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "low": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "En çok alarm üreten IP'ler",
      "description": "Kaynak IP'si olan alarmlar; sudo / su alarmlarında IP bulunmaz.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT host(source_ip) AS \"Kaynak IP\", COUNT(*) AS \"Alarm\",\n       string_agg(DISTINCT rule, ', ' ORDER BY rule) AS \"Kurallar\",\n       (ARRAY_AGG(severity ORDER BY CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END))[1] AS \"En yüksek önem\",\n       MAX(attempt_count) AS \"En çok deneme\", MAX(window_end) AS \"Son görülme\"\nFROM alerts\nWHERE source_ip IS NOT NULL AND $__timeFilter(window_start)\nGROUP BY source_ip\nORDER BY MIN(CASE severity WHEN 'critical' THEN 1 WHEN 'high' THEN 2 WHEN 'medium' THEN 3 ELSE 4 END), COUNT(*) DESC, MAX(attempt_count) DESC\nLIMIT 15"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "En yüksek önem"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "high": {
                        "color": "orange",
                        "index": 1
                      },
                      "medium": {
                        "color": "yellow",
                        "index": 2
                      },
                      "low": {
                        "color": "blue",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "barchart",
      "title": "En çok hedeflenen kullanıcı adları (başarısız deneme)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
