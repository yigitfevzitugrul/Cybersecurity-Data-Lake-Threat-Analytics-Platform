    {
      "id": 14,
      "type": "geomap",
      "title": "Saldırı kaynakları haritası (tüm zamanlar)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "description": "Başarısız SSH denemelerinin kaynak IP'leri; nokta büyüklüğü deneme sayısıdır. Sentetik verideki adresler belgeleme bloklarından seçildiği için haritada yalnızca gerçek (Loghub) saldırganlar görünür. Konum bugünkü veritabanına göredir. Konum verisi: IP Geolocation by DB-IP (https://db-ip.com), CC BY 4.0.",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 16,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT g.latitude, g.longitude, g.country_name AS \"Ülke\", g.city AS \"Şehir\",\n       host(a.source_ip) AS \"IP\", SUM(a.repeat_count) AS \"Başarısız deneme\"\nFROM auth_events a\nJOIN ip_geolocation g ON g.ip = a.source_ip\nWHERE a.event_type = 'login_failed' AND g.latitude IS NOT NULL\nGROUP BY 1, 2, 3, 4, 5\nORDER BY 6 DESC"
        }
      ],
