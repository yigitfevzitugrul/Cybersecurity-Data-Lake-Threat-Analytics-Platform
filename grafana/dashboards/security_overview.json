          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(event_time, '1d'), event_type AS metric, SUM(attempts) AS value\nFROM privilege_events\nWHERE $__timeFilter(event_time)\nGROUP BY 1, 2\nORDER BY 1"
