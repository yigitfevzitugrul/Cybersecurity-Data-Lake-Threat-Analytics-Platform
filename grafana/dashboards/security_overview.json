          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT username, SUM(repeat_count) AS deneme\nFROM auth_events\nWHERE event_type = 'login_failed' AND $__timeFilter(event_time)\nGROUP BY username\nORDER BY 2 DESC\nLIMIT 10"
