    {
      "id": 13,
      "type": "table",
      "title": "Saldırı zincirleri: şüpheli girişten sonra yetki yükseltme",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "description": "escalation_chain alarmları: şüpheli bir girişin ardından aynı hesapla yapılan sudo / su etkinliği.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT window_start AS \"Giriş\", username AS \"Hesap\", host(source_ip) AS \"Kaynak IP\",\n       (details->>'minutes_after_login')::numeric AS \"Girişten sonra (dk)\",\n       attempt_count AS \"Başarısız yetki denemesi\",\n       COALESCE((SELECT string_agg(c, ', ') FROM jsonb_array_elements_text(details->'commands') c), '') AS \"Komutlar\"\nFROM alerts\nWHERE rule = 'escalation_chain' AND $__timeFilter(window_start)\nORDER BY window_start DESC\nLIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 17,
      "type": "barchart",
      "title": "ATT&CK taktiklerine göre alarmlar",
      "description": "Her alarm, kuralına göre bir MITRE ATT&CK taktiğiyle etiketlenir (src/detection/mitre.py). Sıralama ATT&CK matrisindeki sıradır.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT a.mitre_tactic AS taktik, COUNT(*) AS alarm\nFROM alerts a\nLEFT JOIN (SELECT DISTINCT tactic, tactic_id FROM attack_techniques) t ON t.tactic = a.mitre_tactic\nWHERE $__timeFilter(a.window_start) AND a.mitre_tactic IS NOT NULL\nGROUP BY a.mitre_tactic, t.tactic_id\nORDER BY t.tactic_id"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "taktik",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "type": "table",
      "title": "ATT&CK teknikleri",
      "description": "Alarmlarda görülen teknikler. Teknik kimliğine tıklayınca attack.mitre.org sayfası açılır. Taktik, tekniğin bu projedeki bağlamına göredir.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 8,
        "y": 42,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT t.tactic AS \"Taktik\", t.technique_id AS \"Teknik\", t.name AS \"Ad\",\n       COUNT(*) AS \"Alarm\", string_agg(DISTINCT a.rule, ', ') AS \"Kurallar\",\n       MAX(a.window_start) AS \"Son görülme\", t.url\nFROM alerts a\nCROSS JOIN LATERAL unnest(a.mitre_techniques) AS tid\nJOIN attack_techniques t ON t.technique_id = tid\nWHERE $__timeFilter(a.window_start)\nGROUP BY t.tactic_id, t.tactic, t.technique_id, t.name, t.url\nORDER BY t.tactic_id, \"Alarm\" DESC"
        }
      ],
