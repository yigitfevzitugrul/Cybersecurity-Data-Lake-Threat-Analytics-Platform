    {
      "id": 7,
      "type": "timeseries",
      "title": "Saatlik giriş denemeleri",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(event_time, '1h'), event_type AS metric, SUM(repeat_count) AS value\nFROM auth_events\nWHERE $__timeFilter(event_time)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*login_failed.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*login_success.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Karantina: red sebepleri",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT reject_reason, COUNT(*) AS adet\nFROM rejected_events\nWHERE $__timeFilter(rejected_at)\nGROUP BY 1\nORDER BY 2 DESC"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xField": "reject_reason",
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "En çok başarısız deneme yapan IP'ler",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT host(source_ip) AS \"IP\",\n       SUM(repeat_count) AS \"Deneme\",\n       COUNT(DISTINCT username) AS \"Farklı kullanıcı\",\n       MIN(event_time) AS \"İlk\",\n       MAX(event_time) AS \"Son\"\nFROM auth_events\nWHERE event_type = 'login_failed' AND $__timeFilter(event_time)\nGROUP BY source_ip\nORDER BY 2 DESC\nLIMIT 15"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Son pipeline çalıştırmaları",
      "description": "Zaman aralığından bağımsız: en son 20 çalıştırma.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "secdl-postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "secdl-postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT run_id AS \"No\", source_file AS \"Dosya\", status AS \"Durum\", started_at AS \"Başlangıç\",\n       lines_read AS \"Okunan\", lines_rejected AS \"Reddedilen\",\n       events_loaded AS \"Yüklenen\", events_skipped_existing AS \"Zaten var\"\nFROM pipeline_runs\nORDER BY run_id DESC\nLIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Durum"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "success": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
